{
  "manifest_version": 2,
  "name": "Vapor",
  "version": "0.1.0",
  "description": "Vapor colors for Firefox tabs and toolbars in normal and private windows.",
  "author": "orlfman",
  "homepage_url": "https://github.com/orlfman/steamos-vapor-plasma-6.8",
  "browser_specific_settings": {
    "gecko": {
      "id": "vapor-firefox@orlfman.github.io",
      "strict_min_version": "159.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#24272c",
      "frame_inactive": "#24272c",
      "tab_background_text": "#eff0f1",
      "tab_selected": "#569fcc",
      "tab_text": "#1f1f26",
      "tab_line": "#569fcc",
      "tab_loading": "#569fcc",
      "toolbar": "#24272c",
      "toolbar_text": "#eff0f1",
      "icons": "#eff0f1",
      "icons_attention": "#569fcc",
      "button_background_hover": "#2d3136",
      "button_background_active": "#1a212a",
      "toolbar_field": "#151c23",
      "toolbar_field_text": "#eff0f1",
      "toolbar_field_border": "#616569",
      "toolbar_field_focus": "#151c23",
      "toolbar_field_text_focus": "#eff0f1",
      "toolbar_field_border_focus": "#569fcc",
      "toolbar_field_highlight": "#569fcc",
      "toolbar_field_highlight_text": "#1f1f26",
      "toolbar_top_separator": "#151c23",
      "toolbar_bottom_separator": "#151c23",
      "toolbar_vertical_separator": "#616569",
      "popup": "#24272c",
      "popup_text": "#eff0f1",
      "popup_border": "#616569",
      "popup_highlight": "#569fcc",
      "popup_highlight_text": "#1f1f26",
      "sidebar": "#151c23",
      "sidebar_text": "#eff0f1",
      "sidebar_border": "#616569",
      "sidebar_highlight": "#569fcc",
      "sidebar_highlight_text": "#1f1f26",
      "ntp_background": "#151c23",
      "ntp_text": "#eff0f1",
      "ntp_card_background": "#2d3136"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "system"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#24272c",
      "frame_inactive": "#24272c",
      "tab_background_text": "#eff0f1",
      "tab_selected": "#569fcc",
      "tab_text": "#1f1f26",
      "tab_line": "#569fcc",
      "tab_loading": "#569fcc",
      "toolbar": "#24272c",
      "toolbar_text": "#eff0f1",
      "icons": "#eff0f1",
      "icons_attention": "#569fcc",
      "button_background_hover": "#2d3136",
      "button_background_active": "#1a212a",
      "toolbar_field": "#151c23",
      "toolbar_field_text": "#eff0f1",
      "toolbar_field_border": "#616569",
      "toolbar_field_focus": "#151c23",
      "toolbar_field_text_focus": "#eff0f1",
      "toolbar_field_border_focus": "#569fcc",
      "toolbar_field_highlight": "#569fcc",
      "toolbar_field_highlight_text": "#1f1f26",
      "toolbar_top_separator": "#151c23",
      "toolbar_bottom_separator": "#151c23",
      "toolbar_vertical_separator": "#616569",
      "popup": "#24272c",
      "popup_text": "#eff0f1",
      "popup_border": "#616569",
      "popup_highlight": "#569fcc",
      "popup_highlight_text": "#1f1f26",
      "sidebar": "#151c23",
      "sidebar_text": "#eff0f1",
      "sidebar_border": "#616569",
      "sidebar_highlight": "#569fcc",
      "sidebar_highlight_text": "#1f1f26",
      "ntp_background": "#151c23",
      "ntp_text": "#eff0f1",
      "ntp_card_background": "#2d3136"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "system"
    }
  }
}
