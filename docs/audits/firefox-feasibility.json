  "findings": [
    {
      "id": "FFX-01",
      "finding": "Static color themes are the recommended first implementation; browser selection is separate from KDE/GTK selection.",
      "basis": "Installed ThemeManifest/schema/loader plus Mozilla static/dynamic documentation."
    },
    {
      "id": "FFX-02",
      "finding": "Normal themes cannot reproduce arbitrary VGUI2 geometry; custom CSS is a separate maintenance project.",
      "basis": "Installed color mappings; Mozilla advanced-customization and experiment-channel documentation."
    },
    {
      "id": "FFX-03",
      "finding": "Nova changes visible property use and accent behavior. Official static-theme and MDN docs disagree about redesigned sidebar highlight support.",
      "basis": "Current primary documentation and installed loader/CSS. Rendered behavior remains untested."
    },
    {
      "id": "FFX-04",
      "finding": "Original VGUI2 light-on-gold text and original Vapor/VGUI focus colors are weak; retain maintained selection text and trial stronger supported focus roles.",
      "basis": "Opaque-color contrast calculations; no rendered Firefox pass claimed."
    },
    {
      "id": "FFX-05",
      "finding": "Toolbar-button state background changes have no equivalent per-state icon foreground in the normal theme fields.",
      "basis": "Installed schema and theme loader. Require actual icon state tests."
    },
    {
      "id": "FFX-06",
      "finding": "Firefox themes need Mozilla signing for normal release installation; temporary developer loading is not persistent.",
      "basis": "Mozilla signing/static-theme documentation."
    },
    {
      "id": "FFX-07",
      "finding": "Avoid automatic profile/policy changes from AUR; prefer public signed listings and user choice.",
      "basis": "Project architecture recommendation and novice-user installation requirement."
    },
    {
      "id": "FFX-08",
      "finding": "Browser UI automation requires dedicated tools and isolated profiles; none of the checked browser development tools are installed.",
      "basis": "Local PATH/import checks and official web-ext/Marionette/geckodriver documentation."
    }
  ],
